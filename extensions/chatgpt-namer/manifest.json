{
  "manifest_version": 3,
  "name": "Session Deck Namer (manual)",
  "version": "0.3.0",
  "description": "Explicit, one-conversation-at-a-time ChatGPT Web rename helper with UI readback and safe fallback.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Session Deck Namer"
  }
}
