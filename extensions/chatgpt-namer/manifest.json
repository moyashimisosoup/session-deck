{
  "manifest_version": 3,
  "name": "Session Deck Namer",
  "version": "0.5.0",
  "description": "One-conversation ChatGPT rename helper with explicit automatic grant, UI readback and manual-name protection.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "naming-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Session Deck Namer"
  }
}
